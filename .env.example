VITE_API_URL=/api
# Must match the backend BOOKING_HOLD_TTL_MINUTES value (default: 5).
VITE_BOOKING_HOLD_MINUTES=5
# Optional: enable only after implementing the admin-only audit API.
# See src/docs/audit-log-api.md. Leave empty to use the disconnected/preview UI.
VITE_AUDIT_LOG_API_PATH=
# Gemini API key for the AI chatbot widget (CinéBot).
# Get one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
